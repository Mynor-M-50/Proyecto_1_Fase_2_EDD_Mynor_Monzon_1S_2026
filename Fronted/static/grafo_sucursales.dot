graph Sucursales {
	overlap=false splines=true
	node [fillcolor=lightblue fontsize=12 shape=circle style=filled]
	S001 [label=S001 fillcolor=orange]
	S002 [label=S002 fillcolor=orange]
	S003 [label=S003 fillcolor=lightblue]
	S004 [label=S004 fillcolor=lightblue]
	S005 [label=S005 fillcolor=lightblue]
	S001 -- S002 [label="⏱45.0\n💰120.0" color=red penwidth=2.5]
	S001 -- S003 [label="⏱30.0\n💰80.0"]
	S001 -- S004 [label="⏱60.0\n💰150.0"]
	S002 -- S005 [label="⏱50.0\n💰130.0"]
	S003 -- S004 [label="⏱40.0\n💰100.0"]
	S004 -- S005 [label="⏱35.0\n💰90.0"]
}
